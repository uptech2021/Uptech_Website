rules_version = '2';
service firebase.storage { match /b/{bucket}/o {
  function signedIn() { return request.auth != null; }
  function userDoc() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)); }
  function staff() { return signedIn() && (userDoc().data.role == 'staff' || userDoc().data.role == 'hr'); }
  function hr() { return signedIn() && userDoc().data.role == 'hr'; }
  match /hr/{uid}/{file} { allow read: if request.auth.uid == uid || hr(); allow write: if request.auth.uid == uid || hr(); }
  match /{allPaths=**} { allow read, write: if false; }
} }
